__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Never commit corpus bytes, crops or credentials.
corpus/
*.pdf
.env
.venv-datalab/

# Parsed chapter artefacts. The blocks ARE the chapter text and the assets are
# page crops: quarantined content, FORBIDDEN_PENDING_RIGHTS_RECORD (§5, Q3).
# A local commit is not publication, but history outlives the decision to push.
# Regenerate with scripts/assemble_*_quarantine.py + scripts/compose_*.py.
artifacts/*-quarantine/

# Vectors of quarantined chapter text. Regenerate with
# scripts/embed_representations.py; the cache is keyed by text hash.
artifacts/embeddings/

# Everything under artifacts/gold is quarantined content until proven otherwise.
# Review sheets, verification packs and formula sheets all quote the chapter in
# full -- that is the point of them, and it is why they cannot be committed.
#
# This is an allowlist because the deny-list version failed twice: it named
# review-sheet.csv, and review-for-mayank.csv walked straight past it. A new
# export is now ignored by default and has to be argued onto this list.
artifacts/gold/*
!artifacts/gold/.gitkeep
# The gold set itself is questions and block ids, no chapter prose.
!artifacts/gold/pilot-2-chapters-v1.json
# Belt and braces: a review sheet copied anywhere else in the tree.
review*.csv
